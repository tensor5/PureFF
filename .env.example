# Required for GitHub App authentication
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY_PATH=path/to/private-key.pem
# OR
GITHUB_PRIVATE_KEY_BASE64=base64_encoded_key

# Webhook
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Server configuration (optional)
OCTOFER_HOST=127.0.0.1 # Default: 127.0.0.1
OCTOFER_PORT=8000      # Default: 8000

# Logging configuration (optional)
OCTOFER_LOG_LEVEL=info            # Default: info (trace, debug, info, warn, error)
OCTOFER_LOG_FORMAT=compact        # Default: compact (compact, pretty, json)
OCTOFER_LOG_WITH_TARGET=false     # Default: false (show target module)
OCTOFER_LOG_WITH_FILE=false       # Default: false (show file and line info)
OCTOFER_LOG_WITH_THREAD_IDS=false # Default: false (show thread IDs)

# Reqired for finding bot PR comments
BOT_USER_ID=
